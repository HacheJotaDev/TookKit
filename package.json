{
  "name": "hjtools-x",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "build:apk": "mv src/app/api src/app/_api && NEXT_PUBLIC_API_URL=https://hjtools-x.vercel.app next build; mv src/app/_api src/app/api",
    "start": "next start",
    "lint": "eslint .",
